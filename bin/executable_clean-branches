#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage:
  clean-branches              Fetch --prune, then delete local branches whose upstream is gone.
  clean-branches -n           Dry run (list only).
  clean-branches --dry-run    Dry run (list only).
  clean-branches -h           Show help.
  clean-branches --help       Show help.
EOF
}

dry_run=false

case "${1:-}" in
  "")
    ;;
  -n|--dry-run)
    dry_run=true
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option: $1" >&2
    usage
    exit 1
    ;;
esac

git fetch --prune

branches=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2=="[gone]"{print $1}')

if [[ -z "$branches" ]]; then
  echo "No branches to delete."
  exit 0
fi

if [[ "$dry_run" == true ]]; then
  echo "$branches"
else
  echo "$branches" | xargs git branch -D
fi
