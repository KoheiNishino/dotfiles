[alias]
  a   = add
  aa  = add -A
  b   = branch
  bd  = branch -d
  bm  = branch -m
  c   = commit
  ca  = commit --amend
  cm  = commit -m
  cam = commit --allow-empty -m
  d   = diff
  dw  = diff -w
  f   = fetch --prune
  l   = log
  s   = status -sb
  sw  = switch
  swc = switch -c
[init]
  defaultBranch = main
[core]
  pager = delta
[delta]
  line-numbers = true
  side-by-side = true
[interactive]
  diffFilter = delta --color-only
[push]
  autoSetupRemote = true
[pull]
  rebase = false
